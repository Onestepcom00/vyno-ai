# Server
PORT=3001
NODE_ENV=development

# JWT — change this to a long random string before deploying
JWT_SECRET=change_this_to_a_random_secret_string

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vyno
DB_USER=root
DB_PASSWORD=

# Cloudflare Workers AI
# Get your Account ID and token at: https://dash.cloudflare.com/profile/api-tokens
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_AI_TOKEN=your_cloudflare_ai_token
CF_AI_MODEL=@cf/deepseek-ai/deepseek-r1-distill-qwen-32b
# Llama model for prompt rewriting (enriches vague prompts before sending to DeepSeek)
CF_LLAMA_MODEL=@cf/meta/llama-3.1-8b-instruct

# FFmpeg — MUST be an absolute path to the ffmpeg binary
# Windows example: C:/tools/ffmpeg/bin/ffmpeg.exe
# Linux/macOS example: /usr/bin/ffmpeg
FFMPEG_PATH=/usr/bin/ffmpeg

# HyperFrames project storage (relative to backend/)
PROJECTS_BASE_PATH=./projects

# Base audio assets directory (sound-effects + beats-musics) — copied into every new project
# Default: ../tools/assets (relative to backend/)
BASE_ASSETS_PATH=../tools/assets

# Google Gemini Vision API (optional — for image analysis on asset upload)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
